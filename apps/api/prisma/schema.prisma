// Neon Postgres. DATABASE_URL_POOLED = pooled string (host has "-pooler"), used at runtime.
// DATABASE_URL = direct (non-pooled) string, used by `prisma migrate`.
// Events are NOT stored: they are derived by replaying seed + worldSnapshots + decisions through @amt/sim.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL_POOLED")
  directUrl = env("DATABASE_URL")
}

enum RunStatus {
  running
  failed
  completed
}

model Player {
  id          String   @id @default(uuid())
  displayName String   @db.VarChar(24)
  username     String?  @unique @db.VarChar(24)
  passwordHash String?
  createdAt   DateTime @default(now())
  runs        Run[]
}

model Run {
  id             String    @id @default(uuid())
  playerId       String
  player         Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  scenarioId     String
  siteId         String
  seed           Int
  mode           String
  difficulty     String
  status         RunStatus @default(running)
  decisions      Json      @default("[]")
  worldSnapshots Json      @default("[]")
  score          Int?
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?

  @@index([playerId, startedAt])
}

// Cached NASA responses so a restart does not lose the last good snapshot.
model SpaceDataCache {
  key       String   @id
  payload   Json
  fetchedAt DateTime @default(now())
}
