# ---------- apps/api ----------
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/amt
JWT_SECRET=change-me-in-real-envs
CORS_ORIGIN=http://localhost:3000

# NASA (free key from https://api.nasa.gov ; DEMO_KEY is limited to 30 req/hour, 50/day)
NASA_API_KEY=DEMO_KEY
# live = call NASA, cache results | cached = only serve cache | fixture = only recorded samples (demo-safe)
SPACE_DATA_MODE=live
SPACE_DATA_TTL_MINUTES=30

# Comms delay: 1 = real light-time (3-22 min), 0.05 = 20x faster for gameplay
COMMS_TIME_SCALE=0.05

# AI debrief (optional; template fallback is used when empty)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ---------- apps/web ----------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
