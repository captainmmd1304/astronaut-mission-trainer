# Where each variable lives (the same names are used locally and in Vercel/Railway project settings).
# Local files: apps/api/.env and apps/web/.env.local (both gitignored). Next.js only reads env files inside apps/web,
# so NEXT_PUBLIC_* variables must NOT live only in a root .env.

# ---------- apps/api  (copy to apps/api/.env) ----------
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/amt
JWT_SECRET=change-me-in-real-envs
CORS_ORIGIN=http://localhost:3000

# NASA (free key from https://api.nasa.gov ; DEMO_KEY is limited to 30 req/hour, 50/day)
NASA_API_KEY=DEMO_KEY
# live = call NASA, cache results | cached = only serve cache | fixture = only recorded samples (demo-safe)
SPACE_DATA_MODE=live
SPACE_DATA_TTL_MINUTES=30

# Comms delay: 1 = real light-time (3-22 min), 0.05 = 20x faster for gameplay
COMMS_TIME_SCALE=0.05

# AI debrief (optional; template fallback is used when empty)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# ---------- apps/web  (copy to apps/web/.env.local) ----------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000

# ---------- Neon (apps/api) ----------
# DATABASE_URL_POOLED: Neon *pooled* string (host contains "-pooler"), used at runtime.
# DATABASE_URL:        Neon *direct* string, used only by `prisma migrate`. Both end in ?sslmode=require
